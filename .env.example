# 服务器配置
PORT=3000
NODE_ENV=development

# API 认证 Key（所有请求需携带 X-Api-Key 头）
API_KEY=change_me_to_a_long_random_string

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phonenumber_xitong
DB_USER=root
DB_PASSWORD=

# system_config 表中敏感配置的加密密钥（32字节 hex 字符串）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_KEY=

# 运营商适配器选择: mock | juhe | aliyun
# mock 用于开发测试，无需真实 API Key
ACTIVE_ADAPTER=mock

# 钉钉/飞书 Webhook 告警（可选）
ALERT_WEBHOOK_URL=

# 全局低余额预警阈值（元），低于此值发送告警
LOW_BALANCE_THRESHOLD=10
